{:hooks {:analyze-call {omkamra.vice.assembler/define-asm hooks.assembler/define-asm
                         omkamra.vice.assembler/define-asset hooks.assembler/define-asset
                         omkamra.cgen.core/defn hooks.cgen/defn
                         omkamra.cgen.core/fn hooks.cgen/anonymous-fn
                         omkamra.dsp/defn hooks.dsp/defn
                         omkamra.dsp/fn hooks.dsp/dsp-fn
                         omkamra.dsp/defstruct hooks.dsp/dsp-defstruct
                         squint.defclass/defclass hooks.squint/defclass
                         omkamra.vice/with-conn hooks.vice/with-binding-vector
                         omkamra.vice.driver/with-conn hooks.vice/with-binding-vector
                         omkamra.vice.examples.common/with-run hooks.vice/with-binding-vector}}

 :lint-as
 {;; spel ships these as clj-kondo config exports; mirror them here so the
  ;; standalone linter resolves the `with-*` bindings used by
  ;; `omkamra.dsp.browser` without copying dependency configs.
  com.blockether.spel.core/with-playwright clojure.core/with-open
  com.blockether.spel.core/with-browser clojure.core/with-open
  com.blockether.spel.core/with-context clojure.core/with-open
  com.blockether.spel.core/with-page clojure.core/with-open

  ;; `dsp/def` binds a value produced by ordinary Clojure (the combinators), so
  ;; lint it as a `def`. Its body has no DSP data, unlike `dsp/defn`/`dsp/fn`.
  omkamra.dsp/def clojure.core/def}}
