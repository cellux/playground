{:source-paths ["src"]

 :builds
 {:rb.explores.dev.cljs
  {:target :browser
   :output-dir ".dev/cljs/rb/explores/dev/cljs"
   :asset-path "/rb/explores/dev/cljs"
   :modules
   {:main
    {:init-fn rb.explores.dev.cljs/init}}}

  :rb.explores.demo-effects
  {:target :browser
   :output-dir ".dev/cljs/rb/explores/demo-effects"
   :asset-path "/rb/explores/demo-effects"
   :modules
   {:main
    {:init-fn rb.explores.demo-effects/init}}}

  :rb.explores.threejs.earth
  {:target :browser
   :output-dir ".dev/cljs/rb/explores/threejs/earth"
   :asset-path "/rb/explores/threejs/earth"
   :modules
   {:main
    {:init-fn rb.explores.threejs.earth/init}}}

  :omkamra.dsp.harness.testbed
  {:target :browser
   :output-dir ".dev/cljs/omkamra/dsp/harness/testbed"
   :asset-path "/omkamra/dsp/harness/testbed"
   ;; WABT's Emscripten bundle reaches for two Node-only things inside its
   ;; `ENVIRONMENT_IS_NODE` branch, and Shadow resolves both at *build* time
   ;; whether or not that branch ever runs in a browser: the module
   ;; `require("fs")`, and the bare `process` global, which the CommonJS pass
   ;; resolves the way it resolves a module. One stub answers both.
   :js-options
   {:resolve
    {"fs" {:target :file
            :file "src/omkamra/dsp/wabt-fs-stub.js"}
     "process" {:target :file
                 :file "src/omkamra/dsp/wabt-fs-stub.js"}}}
   :modules
   {:main
    {:init-fn omkamra.dsp.harness.testbed/init}}}

  ;; The off-audio-thread event producer (M1). A separate, self-contained build
  ;; rather than a module of the page build: in development Shadow's web-worker
  ;; module loading emits `shadow.loader`/`module_loaded` append files that need
  ;; a `shadow` runtime a web-worker module never gets (the default module hosts
  ;; it). With devtools off and no shared base, `worker/main.js` is a plain
  ;; script that runs `init`. The runtime itself stays a library namespace
  ;; (`omkamra.dsp.hosts.worker`); this build is one consumer of it.
  :omkamra.dsp.hosts.worker
  {:target :browser
   :output-dir ".dev/cljs/omkamra/dsp/hosts/worker"
   :asset-path "/omkamra/dsp/hosts/worker"
   :devtools {:enabled false}
   :modules
   {:main
    {:init-fn omkamra.dsp.hosts.worker/init
     :web-worker true}}}}}
